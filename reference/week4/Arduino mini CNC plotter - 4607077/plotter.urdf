<?xml version="1.0"?>
<robot name="mini_cnc_plotter">

  <material name="purple">
    <color rgba="0.5 0.0 0.5 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="files/1.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="purple"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="files/1.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="files/5.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="purple"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="files/5.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="files/6.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="purple"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="files/6.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="files/7.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="purple"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="files/7.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="files/8.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="purple"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="files/8.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="files/9.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="purple"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="files/9.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="files/A.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="purple"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="files/A.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="files/B.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="purple"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="files/B.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="files/Arduino_mini_CNC_plotter-N1.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="purple"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="files/Arduino_mini_CNC_plotter-N1.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>

  <link name="y_axis">
    <visual>
      <geometry>
        <mesh filename="files/2.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="purple"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="files/2.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>

  <joint name="y_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="y_axis"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.05" upper="0.05" effort="10" velocity="0.1"/>
  </joint>

  <link name="x_axis">
    <visual>
      <geometry>
        <mesh filename="files/3.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="purple"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="files/3.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>

  <joint name="x_joint" type="prismatic">
    <parent link="y_axis"/>
    <child link="x_axis"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.05" upper="0.05" effort="10" velocity="0.1"/>
  </joint>

  <link name="z_axis">
    <visual>
      <geometry>
        <mesh filename="files/4.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="purple"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="files/4.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>

  <joint name="z_joint" type="prismatic">
    <parent link="x_axis"/>
    <child link="z_axis"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.02" upper="0.02" effort="10" velocity="0.1"/>
  </joint>

</robot>
